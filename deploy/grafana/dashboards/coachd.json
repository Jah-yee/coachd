{
  "uid": "coachd",
  "title": "coachd",
  "tags": [
    "coachd"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "label": "Metrics (VictoriaMetrics)",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "current": {}
      },
      {
        "name": "ds_vlogs",
        "label": "Logs (VictoriaLogs)",
        "type": "datasource",
        "query": "victoriametrics-logs-datasource",
        "refresh": 1,
        "hide": 0,
        "current": {}
      },
      {
        "name": "ds_tempo",
        "label": "Traces (Tempo)",
        "type": "datasource",
        "query": "tempo",
        "refresh": 1,
        "hide": 0,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Garmin sync",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Sync runs by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(coachd_garmin_sync_runs_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Last success age by data type",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 10800
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (data_type) (coachd_garmin_sync_last_success_age_seconds)",
          "legendFormat": "{{data_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Key days left",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 7.0001
              },
              {
                "color": "green",
                "value": 14.0001
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(coachd_garmin_key_days_left_days or coachd_garmin_key_days_left)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Red <= 7 days, orange <= 14 days."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Data freshness by data type",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (data_type) (coachd_garmin_data_freshness_seconds)",
          "legendFormat": "{{data_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Garmin requests by endpoint and status class",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (endpoint, status_class) (rate(coachd_garmin_requests_total[$__rate_interval]))",
          "legendFormat": "{{endpoint}} {{status_class}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Garmin request p95 / rate limited",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(coachd_garmin_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{endpoint}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        },
        {
          "expr": "sum(increase(coachd_garmin_rate_limited_total[$__rate_interval]))",
          "legendFormat": "429 responses",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Agents",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []

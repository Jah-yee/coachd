# Copy to .env (never commit .env). Non-secret settings only; tokens live in secrets/.

# --- coachd ---
COACHD_TIMEZONE=Europe/Bratislava
# Expiry date of the Garmin Personal API key (YYYY-MM-DD); coachd warns before it.
COACHD_GARMIN_KEY_EXPIRES=2026-11-22
# Version string baked into the image by `docker compose build`.
COACHD_VERSION=dev
# Run a signed release image instead of building locally (deploy/README.md, "Build or load the image"),
# pinned by digest, e.g. ghcr.io/stefiix92/coachd:0.1.0@sha256:<digest>. Empty = build coachd:local.
#COACHD_IMAGE=

# --- Tuning (optional). Unset or empty = the built-in default shown.
# Scheduled sync interval (Go duration, > 0).
#COACHD_POLL_INTERVAL=1h
# Days of history to backfill on first start (positive integer).
#COACHD_BACKFILL_DAYS=730
# Pause between paced Garmin requests (Go duration, >= 0): backfill requests,
# FIT downloads, long-outage catch-up chunks and deletion-reconcile probes.
#COACHD_BACKFILL_DELAY=1s
# Minimum interval between agent request_sync calls (Go duration, > 0).
#COACHD_SYNC_MIN_INTERVAL=10m

# --- Public lane auth: access or builtin. access = Cloudflare Access in front (the
# three COACHD_ACCESS_* below). builtin = coachd's own OAuth and passkeys, no Access
# (COACHD_ACCESS_* empty; deploy/README.md, "Built-in auth (no Cloudflare Access)").
# Empty = access when all three COACHD_ACCESS_* are set; otherwise no page and no
# public /mcp: the public listener serves only the watch API if COACHD_DEVICE_API=on,
# else it is disabled (cloudflared would get a 502, which is safe).
COACHD_PUBLIC_AUTH=
# builtin only: on = allow dynamic client registration (RFC 7591) for apps that
# cannot identify themselves with a client metadata document URL; empty or off =
# disabled (Claude and ChatGPT do not need it).
COACHD_OAUTH_DCR=

# --- Cloudflare Access (access mode). Set all three together or leave all empty;
# leave them empty with COACHD_PUBLIC_AUTH=builtin.
COACHD_ACCESS_TEAM_DOMAIN=
COACHD_ACCESS_AUD=
COACHD_ACCESS_ALLOWED_EMAIL=
# Public origin of the runner page: https://<host>[:port], no path. Required in
# access and builtin mode. In access mode the Access app must cover this whole
# hostname; in builtin mode every OAuth URL coachd emits is built from it. It is
# also the WebAuthn origin (passkeys are bound to this host). http is accepted only
# for http://localhost[:port], for development.
COACHD_PUBLIC_URL=

# --- ntfy (optional). Full topic URL, e.g. https://ntfy.sh/<secret-topic>.
# Empty = no phone notification. Needs the public lane (the three Access settings
# or COACHD_PUBLIC_AUTH=builtin, and COACHD_PUBLIC_URL). The token (if the topic is
# deny-all) goes in secrets/ntfy_token, which must exist and may be empty.
COACHD_NTFY_URL=

# --- Watch app (optional). on = serve /device/v1/* on the public listener for the
# Connect IQ watch app, outside Cloudflare Access (the device token is the
# credential). Empty or off = disabled. Anything else is an error. With it on and
# neither Access nor builtin auth set up, the public listener serves only /device/v1/*.
# Once an Access app exists, needs a separate path-scoped Access application for
# coachd.<domain>/device/v1 with a single Bypass (Everyone) policy; never add
# Bypass to the main coachd application (see deploy/README.md, "Watch app (M3)").
COACHD_DEVICE_API=

# --- Grafana Cloud and local monitoring ---
# Single on/off switch: uncomment one line to enable Grafana Cloud, local monitoring
# (self-hosted Grafana over Tailscale, deploy/README.md section 6) or both; a bare
# `docker compose up -d` then keeps them on. When turning one off again, run
# `docker compose up -d --remove-orphans` to drop its service (pdc-agent, grafana).
#COMPOSE_FILE=compose.yaml:compose.cloud.yaml
#COMPOSE_FILE=compose.yaml:compose.local.yaml
#COMPOSE_FILE=compose.yaml:compose.cloud.yaml:compose.local.yaml
# Only read when the cloud override is active:
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_OTLP_USER=
GRAFANA_CLOUD_PYROSCOPE_URL=
GRAFANA_CLOUD_PYROSCOPE_USER=
GRAFANA_PDC_CLUSTER=
GRAFANA_PDC_HOSTED_GRAFANA_ID=

# --- Local monitoring. Only read when compose.local.yaml is active: Grafana's URL
# on the Tailscale node (same host as the private MCP lane, path /grafana/), e.g.
# https://raspberrypi-coachd.<tailnet>.ts.net/grafana/
# Empty stops compose with a reminder while local monitoring is on.
GRAFANA_ROOT_URL=

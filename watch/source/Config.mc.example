import Toybox.Lang;

module Config {
    // The coachd URL setting's default: COACHD_PUBLIC_URL in sideloaded
    // builds (they get no phone settings); empty in Store builds.
    const DEFAULT_URL as String = "https://coachd.example.com";
}
